# ============================================
# APPLICATION
# ============================================
APP_NAME="Praximoron"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Bratislava
APP_URL=http://localhost:8000

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=praximoron
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# CACHE & SESSION
# ============================================
CACHE_STORE=database
CACHE_PREFIX=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ============================================
# QUEUE
# ============================================
QUEUE_CONNECTION=database

# ============================================
# MAIL CONFIGURATION
# ============================================
# For local development, use log driver
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="noreply@praximoron.ukf.sk"
# MAIL_FROM_NAME="${APP_NAME}"

# For production with Gmail (uncomment and configure):
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=praximoron@gmail.com
MAIL_PASSWORD=xnhvxekzulttxcsl
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="praximoron@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# For production with Mailgun (uncomment and configure):
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.com
# MAILGUN_SECRET=your-mailgun-key

# ============================================
# LARAVEL SANCTUM (API Authentication)
# ============================================
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,localhost:3000,127.0.0.1:8080

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# BROADCASTING
# ============================================
BROADCAST_CONNECTION=log

# ============================================
# FILESYSTEM
# ============================================
FILESYSTEM_DISK=local

# ============================================
# VITE (Frontend Build Tool)
# ============================================
VITE_APP_NAME="${APP_NAME}"

# ============================================
# AWS S3 (if using cloud storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PUSHER (if using real-time features)
# ============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ============================================
# CUSTOM APPLICATION SETTINGS
# ============================================

# System Settings
SYSTEM_TIMEZONE=Europe/Bratislava
SYSTEM_LOCALE=sk
SYSTEM_FALLBACK_LOCALE=en

# Password Reset Token Expiry (in minutes)
PASSWORD_RESET_EXPIRY=1440

# Account Activation Token Expiry (in hours)
ACTIVATION_TOKEN_EXPIRY=48

# File Upload Settings
MAX_FILE_UPLOAD_SIZE=10240
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Pagination
DEFAULT_PAGINATION_SIZE=20

# Academic Year Settings
CURRENT_ACADEMIC_YEAR=2024/2025
CURRENT_SEMESTER=1

# ============================================
# DEVELOPMENT HELPERS
# ============================================

# Telescope (Laravel debugging tool - optional)
# TELESCOPE_ENABLED=true

# Enable query logging (for debugging)
# DB_LOG_QUERIES=true

# ============================================
# SECURITY SETTINGS
# ============================================

# Rate Limiting (requests per minute)
API_RATE_LIMIT=60
LOGIN_RATE_LIMIT=50

# Token Lifetime (in minutes)
TOKEN_LIFETIME=1440

# ============================================
# EMAIL TEMPLATES
# ============================================
SUPPORT_EMAIL=support@praximoron.ukf.sk

# ============================================
# NOTES
# ============================================
# After creating this file:
# 1. Run: php artisan key:generate
# 2. Configure your database credentials
# 3. Run: php artisan migrate --seed
# 4. Run: php artisan config:clear
# 5. Run: php artisan cache:clear